# Public Docker Compose build inputs. Flutter no longer loads/bundles .env.
# For Flutter run/build arguments, see supabase/scripts/ws4_local_setup.md.
# Never put privileged server keys here or in a Flutter build.
CORVIA_ENV=local
CORVIA_EXPECTED_BACKEND_ORIGIN=
CORVIA_EMERGENCY_DISPATCH_ENABLED=false
CORVIA_WS4_TEAM_EMS_HANDOFF_ENABLED=false

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
PAYMENT_WEBSITE_URL=
# Debug builds default to http://127.0.0.1:8080 when this is empty.
# Release builds require a configured HTTPS payment website origin.
SUPABASE_ANON_KEY=your-anon-key

# MapTiler tile key (https://www.maptiler.com/). Optional - leave blank to
# render maps from OpenStreetMap only. When set, MapTiler is primary and
# OpenStreetMap is the fallback.
MAPTILER_KEY=

# OAuth deep-link (must match Supabase Auth + native intent filters)
OAUTH_REDIRECT_URL=io.supabase.flutter://login-callback/

# WebRTC
STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN servers (recommended for production)
# TURN_SERVER=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
