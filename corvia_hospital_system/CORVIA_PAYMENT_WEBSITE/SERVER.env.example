# Copy this file to .env on the payment server and replace every placeholder.
# Never commit or send the completed .env file.
HOST=0.0.0.0
PORT=8080
PORTAL_BASE_URL=https://pay.example.co.za
PORTAL_PREVIEW=false

SUPABASE_URL=https://supabase.example.co.za
SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Start with sandbox. Change to live only after the full sandbox acceptance test.
PAYFAST_MODE=sandbox
PAYFAST_LIVE_ENABLED=false
PAYFAST_MERCHANT_ID=replace_with_sandbox_merchant_id
PAYFAST_MERCHANT_KEY=replace_with_sandbox_merchant_key
PAYFAST_PASSPHRASE=replace_with_sandbox_passphrase

# Generate a long random value. This signs the short-lived handoff from the app.
PORTAL_LINK_SECRET=replace_with_at_least_32_random_characters

# Caddyfile.example overwrites this header and the app is bound to localhost only.
TRUSTED_CLIENT_IP_HEADER=x-real-ip
