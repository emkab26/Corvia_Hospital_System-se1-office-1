# ─────────────────────────────────────────────
# Supabase CLI & database artefacts
# ─────────────────────────────────────────────
# Full schema + data — never publish the live DB structure/content.
Supabase.sql
# Supabase CLI local state — not useful to other devs, can differ per machine.
supabase/.temp/
supabase/.branches/
# Local seed files may contain real patient / test data.
supabase/seed.sql
supabase/seed.*.sql
# SQL dump / backup files (pg_dump output, manual snapshots, etc.).
*.sql.bak
full_backup.sql
auth_users.sql
*_backup.sql
backup_*.sql

